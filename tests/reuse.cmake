cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/reuse-${MODE}-${suffix}")
file(READ "${SAMPLE_CONFIG}" config)
string(JSON config SET "${config}" num_players 8)
string(JSON config SET "${config}" matches_per_player 20)
string(JSON config SET "${config}" glicko
  "{\"initial_rating\":1500,\"initial_rd\":350,\"rd_growth\":0}")
function(invoke program dir expected)
  file(WRITE "${dir}/stdin.txt" "0\n")
  execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
    TIMEOUT 40 ENCODING UTF-8)
  if(expected STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "実行失敗: ${status} ${out}${err}")
    endif()
  elseif(status STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "期待した拒否ではありません: ${expected}: ${status} ${out}${err}")
  endif()
  if(EXISTS "${dir}/runs/.run_0000.lock" AND NOT expected MATCHES "使用中")
    message(FATAL_ERROR "ロックが残りました")
  endif()
endfunction()
function(manifest run variable)
  file(GLOB_RECURSE files LIST_DIRECTORIES true RELATIVE "${run}" "${run}/*")
  set(contents "${files}\n")
  foreach(name IN LISTS files)
    if(NOT IS_DIRECTORY "${run}/${name}")
      file(SHA256 "${run}/${name}" hash)
      string(APPEND contents "${name}:${hash}\n")
    endif()
  endforeach()
  set(${variable} "${contents}" PARENT_SCOPE)
endfunction()
if(MODE STREQUAL "render")
  if(NOT EXISTS "${GNUPLOT}")
    message("SKIP: gnuplot")
    return()
  endif()
  set(RENDERER "${GNUPLOT}")
endif()
set(template "${root}/template")
file(MAKE_DIRECTORY "${template}/configs/run_0000")
file(WRITE "${template}/configs/run_0000/config.json" "${config}")
invoke("${PROGRAM}" "${template}" "" --png --gnuplot "${RENDERER}")
set(run "${template}/runs/run_0000")
manifest("${run}" baseline)
if(MODE STREQUAL "links")
  foreach(name project10_run.json config.json players.csv latent_parameters.csv ground_truth.csv
      matches.csv elo.csv elo_mse.csv graphs/plot.gp graphs/mse.svg graphs/mse.png)
    configure_file("${run}/${name}" "${root}/protected.csv" COPYONLY)
    file(SHA256 "${root}/protected.csv" original)
    file(REMOVE "${run}/${name}")
    file(CREATE_LINK "${root}/protected.csv" "${run}/${name}" SYMBOLIC RESULT link_error)
    if(NOT link_error STREQUAL "0")
      if(WIN32 AND link_error MATCHES "privilege|1314|権限|特権")
        message("SKIP: symbolic links: ${link_error}")
        return()
      endif()
      message(FATAL_ERROR "リンク作成失敗: ${link_error}")
    endif()
    invoke("${PROGRAM}" "${template}" "エラー" --reuse-existing --png --gnuplot "${RENDERER}")
    file(SHA256 "${root}/protected.csv" after)
    if(NOT after STREQUAL original)
      message(FATAL_ERROR "リンク先が変更されました: ${name}")
    endif()
    file(REMOVE "${run}/${name}")
    configure_file("${root}/protected.csv" "${run}/${name}" COPYONLY)
  endforeach()
  return()
endif()
# 第2PRと同じv1マーカー・全成果物を、外部プログラムなしで繰り返し再利用する。
file(MAKE_DIRECTORY "${root}/run only")
file(COPY "${PROGRAM}" DESTINATION "${root}/run only")
set(alone "${root}/run only/project10_run${EXE}")
foreach(repeat RANGE 1 2)
  invoke("${alone}" "${template}" "" --reuse-existing --gnuplot "${root}/missing gnuplot")
  manifest("${run}" after)
  if(NOT after STREQUAL baseline)
    message(FATAL_ERROR "再利用で既存成果物が変化しました")
  endif()
endforeach()
foreach(case generated_only partial prediction_only)
  set(dir "${root}/${case}")
  file(COPY "${template}/" DESTINATION "${dir}")
  set(run "${dir}/runs/run_0000")
  set(selected "${PROGRAM}")
  if(case STREQUAL "generated_only")
    file(GLOB predictions "${run}/*mse.csv" "${run}/elo.csv" "${run}/glicko.csv"
      "${run}/glicko2.csv" "${run}/trueskill.csv")
    file(REMOVE ${predictions})
    file(REMOVE_RECURSE "${run}/graphs")
  elseif(case STREQUAL "partial")
    file(REMOVE "${run}/glicko2.csv" "${run}/glicko2_mse.csv" "${run}/trueskill_mse.csv")
    file(REMOVE_RECURSE "${run}/graphs")
  else()
    file(REMOVE "${run}/elo_mse.csv")
    set(selected "${alone}")
  endif()
  invoke("${selected}" "${dir}" "" --reuse-existing --png --gnuplot "${RENDERER}")
  manifest("${run}" after)
  if(NOT after STREQUAL baseline)
    message(FATAL_ERROR "再開結果が最初から実行した結果と一致しません: ${case}")
  endif()
endforeach()
if(MODE STREQUAL "render")
  return()
endif()
# 再利用中の子プロセス・描画失敗でも既存成果物を残し、次の実行で不足分を補える。
set(dir "${root}/interrupted")
file(COPY "${template}/" DESTINATION "${dir}")
set(run "${dir}/runs/run_0000")
file(REMOVE "${run}/glicko2.csv" "${run}/glicko2_mse.csv")
file(REMOVE_RECURSE "${run}/graphs")
manifest("${run}" before)
invoke("${alone}" "${dir}" "Glicko2予測" --reuse-existing --gnuplot "${RENDERER}")
manifest("${run}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "子プロセス失敗で既存成果物が変化しました")
endif()
invoke("${PROGRAM}" "${dir}" "gnuplotの起動" --reuse-existing --gnuplot "${root}/missing gnuplot")
if(EXISTS "${run}/graphs" OR NOT EXISTS "${run}/glicko2_mse.csv")
  message(FATAL_ERROR "描画失敗時の成果物・一時領域の状態が不正です")
endif()
invoke("${alone}" "${dir}" "" --reuse-existing --png --gnuplot "${RENDERER}")
manifest("${run}" after)
if(NOT baseline STREQUAL after)
  message(FATAL_ERROR "失敗後の再実行結果が最初から実行した結果と一致しません")
endif()
# 同じJSONの空白差・CRLFのスクリプト・読み取り専用のハードリンクも再利用できる。
set(dir "${root}/format-and-hardlink")
file(COPY "${template}/" DESTINATION "${dir}")
set(run "${dir}/runs/run_0000")
file(APPEND "${dir}/configs/run_0000/config.json" "\n  \n")
file(READ "${run}/graphs/plot.gp" script)
string(REPLACE "\r\n" "\n" script "${script}")
string(REPLACE "\n" "\r\n" script "${script}")
file(WRITE "${run}/graphs/plot.gp" "${script}")
file(RENAME "${run}/elo.csv" "${dir}/protected.csv")
file(CREATE_LINK "${dir}/protected.csv" "${run}/elo.csv" RESULT link_error)
if(NOT link_error STREQUAL "0")
  message(FATAL_ERROR "ハードリンク作成失敗: ${link_error}")
endif()
file(SHA256 "${dir}/protected.csv" protected)
manifest("${run}" before)
invoke("${alone}" "${dir}" "" --reuse-existing --gnuplot "${root}/missing gnuplot")
manifest("${run}" after)
file(SHA256 "${dir}/protected.csv" protected_after)
if(NOT before STREQUAL after OR NOT protected STREQUAL protected_after)
  message(FATAL_ERROR "書式差・共有ファイルの再利用で既存データが変化しました")
endif()
# 手計算: 真値0.5、予測0.75ならMSE=1/16、予測0.5なら0。
# 絶対・相対の丸め許容差の内側と外側を独立した値で検証する。
foreach(case relative_near relative_far absolute_near absolute_far)
  set(dir "${root}/${case}")
  file(COPY "${template}/" DESTINATION "${dir}")
  set(run "${dir}/runs/run_0000")
  set(latent "player_id,theta_0\n")
  foreach(id RANGE 0 7)
    string(APPEND latent "${id},0\n")
  endforeach()
  set(truth "player_a,player_b,p_a_wins\n")
  set(predictions "run_id,matches_per_player,player_a,player_b,predicted_p_a_wins\n")
  set(probability 0.75)
  set(mse 0.062500000005)
  if(case STREQUAL "relative_far")
    set(mse 0.06250000002)
  elseif(case MATCHES "absolute")
    set(probability 0.5)
    set(mse 0.0000000000005)
    if(case STREQUAL "absolute_far")
      set(mse 0.000000000002)
    endif()
  endif()
  foreach(a RANGE 0 6)
    math(EXPR first "${a} + 1")
    foreach(b RANGE ${first} 7)
      string(APPEND truth "${a},${b},0.5\n")
      foreach(t 10 20)
        string(APPEND predictions "0,${t},${a},${b},${probability}\n")
      endforeach()
    endforeach()
  endforeach()
  file(WRITE "${run}/latent_parameters.csv" "${latent}")
  file(WRITE "${run}/ground_truth.csv" "${truth}")
  file(WRITE "${run}/elo.csv" "${predictions}")
  file(WRITE "${run}/elo_mse.csv" "run_id,matches_per_player,mse\n0,10,${mse}\n0,20,${mse}\n")
  file(SHA256 "${run}/elo_mse.csv" original)
  file(REMOVE_RECURSE "${run}/graphs")
  foreach(method glicko glicko2 trueskill)
    file(REMOVE "${run}/${method}.csv" "${run}/${method}_mse.csv")
  endforeach()
  manifest("${run}" before)
  set(expected "")
  if(case MATCHES "far")
    set(expected "保存済みMSEが再計算値と一致しません")
  endif()
  invoke("${PROGRAM}" "${dir}" "${expected}" --reuse-existing --gnuplot "${RENDERER}")
  manifest("${run}" after)
  file(SHA256 "${run}/elo_mse.csv" saved)
  if(NOT original STREQUAL saved OR (case MATCHES "far" AND NOT before STREQUAL after))
    message(FATAL_ERROR "許容誤差の検証で既存成果物が変化しました: ${case}")
  endif()
endforeach()
# 不正な既存成果物は、他手法の欠落を埋める前に拒否する。
foreach(case missing_marker marker_owner marker_version marker_id duplicate_marker changed_seed
    missing_input latent_nan latent_duplicate wrong_truth round_duplicate bad_prediction
    prediction_nan mse_orphan wrong_mse duplicate_mse bad_graph old_scale bad_image busy)
  set(dir "${root}/${case}")
  file(COPY "${template}/" DESTINATION "${dir}")
  set(run "${dir}/runs/run_0000")
  set(expected "再利用検証")
  if(case STREQUAL "missing_marker")
    file(REMOVE "${run}/project10_run.json")
  elseif(case MATCHES "marker_owner|marker_version|marker_id")
    file(READ "${run}/project10_run.json" marker)
    if(case STREQUAL "marker_owner")
      string(JSON marker SET "${marker}" producer "\"other\"")
    elseif(case STREQUAL "marker_version")
      string(JSON marker SET "${marker}" schema_version 2)
    else()
      string(JSON marker SET "${marker}" run_id 1)
    endif()
    file(WRITE "${run}/project10_run.json" "${marker}")
  elseif(case STREQUAL "duplicate_marker")
    file(WRITE "${run}/project10_run.json" "{\"schema_version\":1,\"producer\":\"other\",\"producer\":\"project10_run\",\"run_id\":0}")
  elseif(case STREQUAL "changed_seed")
    string(JSON changed SET "${config}" seeds ability 1)
    file(WRITE "${dir}/configs/run_0000/config.json" "${changed}")
  elseif(case STREQUAL "missing_input")
    file(REMOVE "${run}/latent_parameters.csv")
  elseif(case MATCHES "latent_nan|latent_duplicate")
    file(WRITE "${run}/latent_parameters.csv" "player_id,theta_0\n0,nan\n")
    if(case STREQUAL "latent_duplicate")
      file(WRITE "${run}/latent_parameters.csv" "player_id,theta_0\n0,-1\n0,1\n")
    endif()
  elseif(case STREQUAL "wrong_truth")
    file(READ "${run}/ground_truth.csv" truth)
    string(REGEX REPLACE "0,1,[^\n]*" "0,1,0.123456789" truth "${truth}")
    file(WRITE "${run}/ground_truth.csv" "${truth}")
  elseif(case STREQUAL "round_duplicate")
    set(matches "match_id,period_id,player_a,player_b,result_a\n")
    foreach(id RANGE 0 79)
      math(EXPR period "${id} / 40")
      math(EXPR a "(${id} % 4) * 2")
      math(EXPR b "${a} + 1")
      if(id EQUAL 1)
        set(a 0)
      elseif(id EQUAL 4)
        set(a 2)
      endif()
      string(APPEND matches "${id},${period},${a},${b},1\n")
    endforeach()
    file(WRITE "${run}/matches.csv" "${matches}")
  elseif(case STREQUAL "bad_prediction" OR case STREQUAL "prediction_nan")
    file(WRITE "${run}/elo.csv" "wrong_header\n")
    if(case STREQUAL "prediction_nan")
      file(WRITE "${run}/elo.csv" "run_id,matches_per_player,player_a,player_b,predicted_p_a_wins\n0,10,0,1,nan\n")
    endif()
  elseif(case STREQUAL "mse_orphan")
    file(REMOVE "${run}/elo.csv")
  elseif(case STREQUAL "wrong_mse" OR case STREQUAL "duplicate_mse")
    file(WRITE "${run}/elo_mse.csv" "run_id,matches_per_player,mse\n0,10,1\n0,20,1\n")
    if(case STREQUAL "duplicate_mse")
      file(APPEND "${run}/elo_mse.csv" "0,10,1\n")
    endif()
  elseif(case STREQUAL "bad_graph")
    file(APPEND "${run}/graphs/plot.gp" "set xrange [0:1]\n")
    set(expected "描画データ・条件")
  elseif(case STREQUAL "old_scale")
    file(READ "${run}/graphs/plot.gp" script)
    string(REGEX REPLACE "set yrange \\[0:[^]]+\\]" "set yrange [0:1]" script "${script}")
    file(WRITE "${run}/graphs/plot.gp" "${script}")
    set(expected "描画データ・条件")
  elseif(case STREQUAL "bad_image")
    file(WRITE "${run}/graphs/mse.svg" "broken image")
    set(expected "出力画像が不正")
  elseif(case STREQUAL "busy")
    file(MAKE_DIRECTORY "${dir}/runs/.run_0000.lock")
    set(expected "使用中")
  endif()
  if(expected STREQUAL "再利用検証")
    file(REMOVE "${run}/trueskill.csv" "${run}/trueskill_mse.csv")
  endif()
  manifest("${run}" before)
  invoke("${PROGRAM}" "${dir}" "${expected}" --reuse-existing --gnuplot "${RENDERER}")
  manifest("${run}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "不正な既存成果物の検査でファイルを変更しました: ${case}")
  endif()
  if(case STREQUAL "old_scale")
    manifest("${run}/graphs" original_graphs)
    invoke("${PROGRAM}" "${dir}" "" --reuse-existing --png --name graphs-auto --gnuplot "${RENDERER}")
    manifest("${run}/graphs" saved_graphs)
    file(READ "${run}/graphs-auto/plot.gp" new_script)
    if(NOT original_graphs STREQUAL saved_graphs OR new_script STREQUAL script)
      message(FATAL_ERROR "旧スケールのグラフを保持して別名へ描画できませんでした")
    endif()
  endif()
endforeach()
# PNGの追加や壊れた既存図の再描画には、明示した別名だけを使う。
file(REMOVE "${template}/runs/run_0000/graphs/mse.png")
invoke("${PROGRAM}" "${template}" "PNGがありません" --reuse-existing --png --gnuplot "${RENDERER}")
invoke("${PROGRAM}" "${template}" "" --reuse-existing --png --name graphs-v2 --gnuplot "${RENDERER}")
if(EXISTS "${template}/runs/run_0000/graphs/mse.png" OR
    NOT EXISTS "${template}/runs/run_0000/graphs-v2/mse.png")
  message(FATAL_ERROR "既存図を変更せず別名へ保存できませんでした")
endif()
