function(plot expected_error)
  execute_process(COMMAND "${PROGRAM}" --gnuplot "${GNUPLOT}" ${ARGN}
    WORKING_DIRECTORY "${work}" INPUT_FILE "${work}/stdin.txt"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 30)
  if(expected_error STREQUAL "")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "描画に失敗しました: ${result} ${output}${error}")
    endif()
    if(NOT output MATCHES "使用: Elo")
      message(FATAL_ERROR "使用した手法を明示していません: ${output}")
    endif()
  elseif(result STREQUAL "0" OR NOT error MATCHES "${expected_error}")
    message(FATAL_ERROR "期待したエラー「${expected_error}」と異なります: ${result} ${output}${error}")
  endif()
  set(last_output "${output}" PARENT_SCOPE)
endfunction()

function(check_y_range directory expected)
  file(READ "${run}/${directory}/plot.gp" script)
  string(REGEX MATCH "set yrange \\[0:([^]]+)\\]" range "${script}")
  if(range STREQUAL "" OR NOT CMAKE_MATCH_1 EQUAL expected)
    message(FATAL_ERROR "縦軸は0〜${expected}を期待しました: ${range}")
  endif()
endfunction()

# 上限は全手法・全評価時点の最大値に合わせ、零点・微小値・確率誤差の上限も描画する。
