set(scale_png)
if(MODE STREQUAL "render")
  set(scale_png --png)
endif()
set(index 0)
foreach(example "0.042,0.05" "0,0.01" "1e-9,2e-9" "0.95,1" "1,1")
  math(EXPR index "${index} + 1")
  string(REPLACE "," ";" values "${example}")
  list(GET values 0 value)
  list(GET values 1 expected)
  file(WRITE "${run}/custom_elo.csv" "${header}0,10,0\n0,20,${value}\n")
  plot("" --name "scale-${index}" ${scale_png})
  check_y_range("scale-${index}" "${expected}")
  if(MODE STREQUAL "render")
    file(READ "${run}/scale-${index}/mse.png" signature LIMIT 8 HEX)
    if(NOT signature STREQUAL "89504e470d0a1a0a")
      message(FATAL_ERROR "自動軸のPNGを生成できませんでした: ${example}")
    endif()
  endif()
endforeach()
