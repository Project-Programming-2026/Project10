cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/comparison-${MODE}-${suffix}")
set(work "${root}/normal")
file(READ "${SOURCE}/configs/run_0004/config.json" calibration)
file(READ "${SOURCE}/configs/run_0005/config.json" target)
string(JSON calibration SET "${calibration}" run_id 0)
string(JSON target SET "${target}" run_id 1)
foreach(name calibration target)
  string(JSON ${name} SET "${${name}}" num_players 8)
  string(JSON ${name} SET "${${name}}" matches_per_player 20)
endforeach()
function(prepare dir id config)
  file(MAKE_DIRECTORY "${dir}/configs/run_000${id}")
  file(WRITE "${dir}/configs/run_000${id}/config.json" "${config}")
endfunction()
function(invoke dir input expected)
  file(WRITE "${dir}/stdin.txt" "${input}")
  execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
    TIMEOUT 40 ENCODING UTF-8)
  if(expected STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "比較実行失敗: ${status}: ${out}${err}")
    endif()
  elseif(status STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "期待した拒否ではありません: ${expected}: ${status}: ${out}${err}")
  endif()
endfunction()
function(manifest dir result)
  file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
  set(text "")
  foreach(file IN LISTS files)
    file(SHA256 "${dir}/${file}" hash)
    string(APPEND text "${file}:${hash}\n")
  endforeach()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()
prepare("${work}" 0 "${calibration}")
prepare("${work}" 1 "${target}")
file(MAKE_DIRECTORY "${work}/samples")
file(COPY "${SOURCE}/samples/glicko_baseline" DESTINATION "${work}/samples")
set(program "${PROGRAM}")
set(renderer "${PROBE}")
if(MODE STREQUAL "render")
  if(NOT EXISTS "${GNUPLOT}")
    message("SKIP: gnuplot")
    return()
  endif()
  set(renderer "${GNUPLOT}")
else()
  set(tools "${root}/tools with spaces")
  file(MAKE_DIRECTORY "${tools}")
  foreach(name project10_run project10_glicko project10_trueskill)
    file(COPY "${BIN}/${name}${EXE}" DESTINATION "${tools}")
  endforeach()
  configure_file("${BIN}/project10_predict${EXE}" "${tools}/real_project10_predict${EXE}" COPYONLY)
  configure_file("${PROBE}" "${tools}/project10_predict${EXE}" COPYONLY)
  set(program "${tools}/project10_run${EXE}")
endif()
invoke("${work}" "0\n" "" --comparison --png --gnuplot "${renderer}")
manifest("${work}/runs/run_0000" referenceBefore)
invoke("${work}" "1\n" "" --comparison --all-methods --png --gnuplot "${renderer}")
manifest("${work}/runs/run_0000" referenceAfter)
if(NOT referenceBefore STREQUAL referenceAfter)
  message(FATAL_ERROR "参照runを変更しました")
endif()
set(run "${work}/runs/run_0001")
file(READ "${run}/project10_run.json" marker)
string(JSON mode GET "${marker}" mode)
file(READ "${run}/graphs/plot.gp" script)
if(NOT mode STREQUAL "conditional_fixed_reference_v1" OR
    NOT script MATCHES "S1; conditional, both sides" OR NOT script MATCHES "fixed baseline" OR
    script MATCHES "smoke" OR EXISTS "${work}/runs/.run_0001.lock")
  message(FATAL_ERROR "比較モード・描画・ロックが不正です")
endif()
foreach(stem elo glicko glicko2 trueskill advantage_elo ranked_glicko2)
  file(STRINGS "${run}/${stem}.csv" predictions)
  file(STRINGS "${run}/${stem}_mse.csv" mse)
  list(LENGTH predictions rows)
  list(LENGTH mse points)
  set(expected 57)
  if(stem STREQUAL "advantage_elo")
    set(expected 113)
  endif()
  if(NOT rows EQUAL expected OR NOT points EQUAL 3)
    message(FATAL_ERROR "条件付き評価ペア・時点数が違います: ${stem}")
  endif()
endforeach()
foreach(stem mse online_log_loss online_brier)
  foreach(ext svg png)
    if(NOT EXISTS "${run}/graphs/${stem}.${ext}")
      message(FATAL_ERROR "比較画像がありません: ${stem}.${ext}")
    endif()
  endforeach()
endforeach()
foreach(name config.json glicko2_rating.csv)
  file(SHA256 "${run}/ranked_reference/glicko_baseline/${name}" actual)
  file(SHA256 "${SOURCE}/samples/glicko_baseline/${name}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "参照分布・設定が固定されていません")
  endif()
endforeach()
if(MODE STREQUAL "render")
  return()
endif()
manifest("${run}" original)
# 生成CLIへ明示確認を渡しても比較用runを上書きしない。
file(WRITE "${work}/stdin.txt" "1\ny\n")
execute_process(COMMAND "${BIN}/project10${EXE}" WORKING_DIRECTORY "${work}"
  INPUT_FILE "${work}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(status STREQUAL "0" OR NOT "${out}${err}" MATCHES "比較用runは上書きできません")
  message(FATAL_ERROR "比較用runの上書きを拒否しませんでした: ${out}${err}")
endif()
manifest("${run}" afterOverwrite)
if(NOT original STREQUAL afterOverwrite)
  message(FATAL_ERROR "生成CLIが比較用runを変更しました")
endif()
# 固定済み参照を使うため、元のsamplesを移動しても再利用できる。
file(RENAME "${work}/samples/glicko_baseline" "${root}/reference-archive")
invoke("${work}" "1\n" "" --comparison --all-methods --reuse-existing --png --gnuplot missing)
foreach(stem ranked_glicko2 online_metrics advantage_elo)
  file(REMOVE "${run}/${stem}.csv")
  if(NOT stem STREQUAL "online_metrics")
    file(REMOVE "${run}/${stem}_mse.csv")
  endif()
  if(stem STREQUAL "advantage_elo")
    file(REMOVE "${run}/online_predictions.csv" "${run}/online_metrics.csv")
  endif()
  invoke("${work}" "1\n" "" --comparison --all-methods --reuse-existing --png --gnuplot missing)
  manifest("${run}" regenerated)
  if(NOT original STREQUAL regenerated)
    message(FATAL_ERROR "比較成果物の再生成が一致しません: ${stem}")
  endif()
endforeach()
file(RENAME "${root}/reference-archive" "${work}/samples/glicko_baseline")
foreach(case conditions truth log metrics reference orphan changed_mode changed_reference)
  set(dir "${root}/bad-${case}")
  file(MAKE_DIRECTORY "${dir}")
  file(COPY "${work}/configs" "${work}/runs" DESTINATION "${dir}")
  set(saved "${dir}/runs/run_0001")
  set(options --comparison --all-methods)
  if(case STREQUAL "conditions")
    file(WRITE "${saved}/conditions.csv" "match_id,z\n0,0\n")
  elseif(case STREQUAL "truth")
    file(WRITE "${saved}/ground_truth_positive.csv" "wrong\n")
  elseif(case STREQUAL "log")
    file(WRITE "${saved}/online_predictions.csv" "run_id,match_id,z,result_a,p_elo,p_advantage\n1,0,1,1,nan,.5\n")
  elseif(case STREQUAL "metrics")
    file(WRITE "${saved}/online_metrics.csv" "run_id,matches_per_player,elo_log_loss,advantage_log_loss,elo_brier,advantage_brier\n1,10,0,0,0,0\n1,20,0,0,0,0\n")
  elseif(case STREQUAL "reference")
    file(WRITE "${saved}/ranked_reference/glicko_baseline/glicko2_rating.csv" "rating\nnan\n")
  elseif(case STREQUAL "orphan")
    file(REMOVE "${saved}/online_predictions.csv")
  elseif(case STREQUAL "changed_mode")
    set(options --all-methods)
  else()
    set(options --comparison)
  endif()
  manifest("${saved}" before)
  invoke("${dir}" "1\n" "エラー" ${options} --reuse-existing --gnuplot "${renderer}")
  manifest("${saved}" after)
  if(NOT before STREQUAL after OR EXISTS "${dir}/runs/.run_0001.lock")
    message(FATAL_ERROR "不正入力の拒否で既存runを変更しました: ${case}")
  endif()
endforeach()
foreach(case missing_baseline same_seed invalid_baseline missing_setting negative_delta invalid_scenario
    negative_condition_seed negative_learning_rate legacy_option)
  set(dir "${root}/invalid-${case}")
  file(MAKE_DIRECTORY "${dir}/runs")
  file(MAKE_DIRECTORY "${dir}/samples")
  file(COPY "${SOURCE}/samples/glicko_baseline" DESTINATION "${dir}/samples")
  set(config "${target}")
  set(options --comparison --all-methods)
  if(case STREQUAL "missing_baseline")
    file(REMOVE "${dir}/samples/glicko_baseline/glicko2_rating.csv")
  elseif(case STREQUAL "same_seed")
    string(JSON config SET "${config}" seeds ability 20261016010)
  elseif(case STREQUAL "invalid_baseline")
    file(WRITE "${dir}/samples/glicko_baseline/glicko2_rating.csv" "rating\nnan\n")
  elseif(case STREQUAL "missing_setting")
    string(JSON config REMOVE "${config}" advantage_elo)
  elseif(case STREQUAL "negative_delta")
    string(JSON config SET "${config}" comparison side_advantage -1)
  elseif(case STREQUAL "invalid_scenario")
    string(JSON config SET "${config}" comparison scenario "\"S2\"")
  elseif(case STREQUAL "negative_condition_seed")
    string(JSON config SET "${config}" comparison condition_seed -1)
  elseif(case STREQUAL "negative_learning_rate")
    string(JSON config SET "${config}" advantage_elo k_advantage -1)
  else()
    list(APPEND options --ranked-reference-run 0)
  endif()
  prepare("${dir}" 1 "${config}")
  manifest("${dir}/samples" before)
  invoke("${dir}" "1\n" "エラー" ${options})
  manifest("${dir}/samples" after)
  if(EXISTS "${dir}/runs/run_0001" OR NOT before STREQUAL after)
    message(FATAL_ERROR "設定・参照不正でrunを作成または変更しました: ${case}")
  endif()
endforeach()
# S0も同じ条件付き評価経路を使う。結果を見て設定値を合わせる検証ではない。
set(control "${root}/s0")
foreach(id 6 7)
  file(READ "${SOURCE}/configs/run_000${id}/config.json" config)
  math(EXPR smallID "${id} - 6")
  string(JSON config SET "${config}" run_id ${smallID})
  string(JSON config SET "${config}" num_players 8)
  string(JSON config SET "${config}" matches_per_player 20)
  prepare("${control}" ${smallID} "${config}")
endforeach()
invoke("${control}" "0\n" "" --comparison --gnuplot "${renderer}")
invoke("${control}" "0\n" "" --comparison --reuse-existing --gnuplot missing)
file(MAKE_DIRECTORY "${control}/samples")
file(COPY "${SOURCE}/samples/glicko_baseline" DESTINATION "${control}/samples")
invoke("${control}" "1\n" "" --comparison --all-methods --gnuplot "${renderer}")
