cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/six-${MODE}-${suffix}")
set(work "${root}/normal")
file(READ "${SAMPLE_CONFIG}" config)
string(JSON config SET "${config}" run_id 0)
string(JSON config SET "${config}" num_players 8)
string(JSON config SET "${config}" matches_per_player 20)
function(prepare dir text)
  file(MAKE_DIRECTORY "${dir}/configs/run_0000")
  file(WRITE "${dir}/configs/run_0000/config.json" "${text}")
  file(MAKE_DIRECTORY "${dir}/samples")
  file(COPY "${BASELINE}" DESTINATION "${dir}/samples")
endfunction()
function(invoke program dir input expected)
  file(WRITE "${dir}/stdin.txt" "${input}")
  execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
    TIMEOUT 40 ENCODING UTF-8)
  if(expected STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "6手法実行失敗: ${status}: ${out}${err}")
    endif()
  elseif(status STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "期待した拒否ではありません: ${expected}: ${status}: ${out}${err}")
  endif()
endfunction()
function(manifest dir result)
  file(GLOB_RECURSE files RELATIVE "${dir}" "${dir}/*")
  set(text "")
  foreach(file IN LISTS files)
    file(SHA256 "${dir}/${file}" hash)
    string(APPEND text "${file}:${hash}\n")
  endforeach()
  set(${result} "${text}" PARENT_SCOPE)
endfunction()
prepare("${work}" "${config}")
set(program "${PROGRAM}")
set(renderer "${PROBE}")
if(MODE STREQUAL "render")
  if(NOT EXISTS "${GNUPLOT}")
    message("SKIP: gnuplot")
    return()
  endif()
  set(renderer "${GNUPLOT}")
else()
  set(tools "${root}/tools with spaces")
  file(MAKE_DIRECTORY "${tools}")
  foreach(name project10_run project10_glicko project10_trueskill)
    file(COPY "${BIN}/${name}${EXE}" DESTINATION "${tools}")
  endforeach()
  configure_file("${BIN}/project10_predict${EXE}" "${tools}/real_project10_predict${EXE}" COPYONLY)
  configure_file("${PROBE}" "${tools}/project10_predict${EXE}" COPYONLY)
  set(program "${tools}/project10_run${EXE}")
endif()
invoke("${program}" "${work}" "0\n" "" --all-methods --png --gnuplot "${renderer}")
set(run "${work}/runs/run_0000")
file(READ "${run}/project10_run.json" marker)
string(JSON mode GET "${marker}" mode)
file(READ "${run}/graphs/plot.gp" script)
if(NOT mode STREQUAL "six_method_fixed_reference_v1" OR NOT script MATCHES "fixed baseline; PR #28" OR
    script MATCHES "smoke test only" OR
    NOT script MATCHES "Advantage-Elo" OR NOT script MATCHES "ranked Glicko-2" OR
    EXISTS "${work}/runs/.run_0000.lock")
  message(FATAL_ERROR "6手法のモード・描画・ロックが不正です")
endif()
foreach(name config.json glicko2_rating.csv)
  file(SHA256 "${BASELINE}/${name}" expected)
  file(SHA256 "${run}/ranked_reference/glicko_baseline/${name}" saved)
  file(SHA256 "${work}/samples/glicko_baseline/${name}" source)
  if(NOT expected STREQUAL saved OR NOT expected STREQUAL source)
    message(FATAL_ERROR "PR #28の固定参照が変更されたか、保存値と一致しません")
  endif()
endforeach()
set(stems elo glicko glicko2 trueskill advantage_elo ranked_glicko2)
foreach(stem IN LISTS stems)
  file(STRINGS "${run}/${stem}.csv" predictions)
  file(STRINGS "${run}/${stem}_mse.csv" mse)
  list(LENGTH predictions rows)
  list(LENGTH mse points)
  if(NOT rows EQUAL 57 OR NOT points EQUAL 3)
    message(FATAL_ERROR "評価ペア・時点の数が違います: ${stem}")
  endif()
endforeach()
if(MODE STREQUAL "render")
  return()
endif()
# 個別CLIで同じ履歴を処理した場合と、全予測・MSE・参照分布が一致する。
set(reference "${root}/individual")
prepare("${reference}" "${config}")
invoke("${BIN}/project10${EXE}" "${reference}" "0\n" "")
set(methods Elo Glicko Glicko2 TrueSkill AdvantageElo rankedGlicko2)
foreach(method IN LISTS methods)
  if(method STREQUAL "Glicko")
    invoke("${BIN}/project10_glicko${EXE}" "${reference}" "0\n" "")
  elseif(method STREQUAL "TrueSkill")
    invoke("${BIN}/project10_trueskill${EXE}" "${reference}" "0\n" "")
  else()
    invoke("${BIN}/project10_predict${EXE}" "${reference}" "" "" 0 "${method}")
  endif()
  invoke("${BIN}/project10_evaluate${EXE}" "${reference}" "0\n${method}\n" "")
endforeach()
file(GLOB csvs RELATIVE "${run}" "${run}/*.csv")
foreach(csv IN LISTS csvs)
  file(SHA256 "${run}/${csv}" actual)
  file(SHA256 "${reference}/runs/run_0000/${csv}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "個別実行と不一致: ${csv}")
  endif()
endforeach()
file(REMOVE "${reference}/runs/run_0000/ranked_glicko2.csv" "${reference}/runs/run_0000/ranked_glicko2_mse.csv")
# 評価run自身の分布が不正でも、ranked単体はPR #28の固定分布を使用する。
file(WRITE "${reference}/runs/run_0000/glicko2_rating.csv" "rating\nnan\n")
invoke("${BIN}/project10_predict${EXE}" "${reference}" "" "" 0 rankedGlicko2)
file(SHA256 "${reference}/runs/run_0000/ranked_glicko2.csv" actual)
file(SHA256 "${run}/ranked_glicko2.csv" expected)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "rankedが評価run自身の分布に影響されました")
endif()
manifest("${run}" original)
invoke("${program}" "${work}" "0\ny\n" "既存run" --all-methods)
file(REMOVE_RECURSE "${work}/samples/glicko_baseline")
invoke("${program}" "${work}" "0\n" "" --all-methods --reuse-existing --png --gnuplot missing-gnuplot)
manifest("${run}" reused)
if(NOT original STREQUAL reused)
  message(FATAL_ERROR "全件再利用で成果物を変更しました")
endif()
foreach(stem advantage_elo ranked_glicko2)
  file(REMOVE "${run}/${stem}.csv" "${run}/${stem}_mse.csv")
  invoke("${program}" "${work}" "0\n" "" --all-methods --reuse-existing --png --gnuplot missing-gnuplot)
  manifest("${run}" regenerated)
  if(NOT original STREQUAL regenerated)
    message(FATAL_ERROR "欠落手法の再生成が一致しません: ${stem}")
  endif()
endforeach()
foreach(case missing_reference invalid_reference orphan_ranked broken_advantage changed_mode old_mode)
  set(dir "${root}/${case}")
  file(MAKE_DIRECTORY "${dir}")
  file(COPY "${work}/configs" "${work}/runs" DESTINATION "${dir}")
  set(saved "${dir}/runs/run_0000")
  set(options --all-methods)
  set(expected "再利用検証")
  if(case STREQUAL "missing_reference")
    file(REMOVE "${saved}/ranked_reference/glicko_baseline/glicko2_rating.csv")
  elseif(case STREQUAL "invalid_reference")
    file(WRITE "${saved}/ranked_reference/glicko_baseline/glicko2_rating.csv" "rating\nnan\n")
  elseif(case STREQUAL "orphan_ranked")
    file(REMOVE "${saved}/glicko2.csv" "${saved}/glicko2_rating.csv")
  elseif(case STREQUAL "broken_advantage")
    file(WRITE "${saved}/advantage_elo.csv" "wrong_header\n")
  elseif(case STREQUAL "old_mode")
    file(WRITE "${saved}/project10_run.json" "{\"schema_version\":1,\"producer\":\"project10_run\",\"run_id\":0,\"mode\":\"six_method_smoke_v1\"}")
  else()
    set(options "")
  endif()
  manifest("${saved}" before)
  invoke("${program}" "${dir}" "0\n" "${expected}" ${options} --reuse-existing --gnuplot "${renderer}")
  manifest("${saved}" after)
  if(NOT before STREQUAL after OR EXISTS "${dir}/runs/.run_0000.lock")
    message(FATAL_ERROR "不正成果物の拒否でrunまたはロックを変更しました: ${case}")
  endif()
endforeach()
set(legacy "${root}/legacy")
prepare("${legacy}" "${config}")
invoke("${program}" "${legacy}" "0\n" "" --gnuplot "${renderer}")
manifest("${legacy}/runs/run_0000" before)
invoke("${program}" "${legacy}" "0\n" "実行モード" --all-methods --reuse-existing)
manifest("${legacy}/runs/run_0000" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "従来runを6手法モードへ変更しました")
endif()
set(bad "${root}/missing_setting")
string(JSON invalid REMOVE "${config}" files predictions AdvantageElo)
prepare("${bad}" "${invalid}")
invoke("${program}" "${bad}" "0\n" "設定確認" --all-methods)
if(EXISTS "${bad}/runs/run_0000")
  message(FATAL_ERROR "設定不正なのにrunを作成しました")
endif()
foreach(case missing_baseline wrong_header wrong_count infinite_rating same_seed)
  set(dir "${root}/${case}")
  set(settings "${config}")
  if(case STREQUAL "same_seed")
    string(JSON settings SET "${settings}" seeds result 20261016030)
  endif()
  prepare("${dir}" "${settings}")
  set(csv "${dir}/samples/glicko_baseline/glicko2_rating.csv")
  if(case STREQUAL "missing_baseline")
    file(REMOVE "${csv}")
  elseif(case STREQUAL "wrong_header")
    file(WRITE "${csv}" "wrong\n1500\n1500\n")
  elseif(case STREQUAL "wrong_count")
    file(WRITE "${csv}" "rating\n1500\n1500\n")
  elseif(case STREQUAL "infinite_rating")
    file(WRITE "${csv}" "rating\ninf\n1500\n")
  endif()
  manifest("${dir}/samples" before)
  invoke("${program}" "${dir}" "0\n" "設定確認" --all-methods)
  manifest("${dir}/samples" after)
  if(EXISTS "${dir}/runs/run_0000" OR NOT before STREQUAL after)
    message(FATAL_ERROR "固定参照不正で入力を変更またはrunを作成しました: ${case}")
  endif()
endforeach()
set(protected "${root}/protected-final-rating")
prepare("${protected}" "${config}")
invoke("${BIN}/project10${EXE}" "${protected}" "0\n" "")
file(WRITE "${protected}/runs/run_0000/glicko2_rating.csv" "existing result\n")
manifest("${protected}/runs/run_0000" before)
invoke("${BIN}/project10_predict${EXE}" "${protected}" "" "すでに存在" 0 Glicko2)
manifest("${protected}/runs/run_0000" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Glicko2の既存最終レートを上書きしました")
endif()
