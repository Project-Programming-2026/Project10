cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${TEST_ROOT}/file-series-cli-${suffix}")
file(MAKE_DIRECTORY "${work}/runs/run_0001")
file(WRITE "${work}/runs/run_0001/config.json"
  "{\"run_id\":1,\"num_players\":2,\"matches_per_player\":10,\"evaluation_interval_matches_per_player\":10}")
file(WRITE "${work}/runs/run_0001/players.csv" "player_id\n0\n1\n")
file(WRITE "${work}/runs/run_0001/ground_truth.csv" "player_a,player_b,p_a_wins\n0,1,0.5\n")
file(WRITE "${work}/日本語 空白.csv"
  "run_id,matches_per_player,player_a,player_b,predicted_p_a_wins\n1,10,0,1,0.75\n")

function(invoke program expected)
  execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${work}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 20)
  if(expected STREQUAL "")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "CLIが失敗しました: ${result} ${output}${error}")
    endif()
  elseif(result STREQUAL "0" OR NOT error MATCHES "${expected}")
    message(FATAL_ERROR "想定したCLIエラーがありません: ${expected}: ${result} ${output}${error}")
  endif()
endfunction()

invoke("${EVALUATOR}" "" --help)
invoke("${PLOTTER}" "" --help)
invoke("${EVALUATOR}" "" --input "Elo A" 1 "${work}/日本語 空白.csv"
  --input "Elo B" 1 "日本語 空白.csv" --name evaluated)
file(READ "${work}/runs/comparisons/evaluated/series_0002_mse.csv" mse)
if(NOT mse MATCHES "1,10,0.0625")
  message(FATAL_ERROR "2つ目のMSEが手計算と一致しません: ${mse}")
endif()
file(READ "${work}/runs/comparisons/evaluated/manifest.json" manifest)
string(JSON recorded GET "${manifest}" arguments 1)
if(NOT recorded STREQUAL "Elo A")
  message(FATAL_ERROR "実行引数がmanifestへ記録されていません")
endif()
set(input "runs/comparisons/evaluated/series_0001_mse.csv")
invoke("${PLOTTER}" "" --input "凡例 空白" 1 "${input}" --name graph --gnuplot "${RENDERER}")
file(SHA256 "${work}/runs/comparisons/graph/mse.svg" before)
invoke("${PLOTTER}" "比較出力先がすでに存在します"
  --input label 1 "${input}" --name graph --gnuplot "${RENDERER}")
file(SHA256 "${work}/runs/comparisons/graph/mse.svg" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "既存グラフが変更されました")
endif()
foreach(program "${EVALUATOR}" "${PLOTTER}")
  invoke("${program}" "引数不足" --input label)
  invoke("${program}" "run ID" --input label 1junk "${input}" --name bad)
  invoke("${program}" "run ID" --input label -1 "${input}" --name bad)
  invoke("${program}" "出力名" --input label 1 "${input}")
  invoke("${program}" "表示名が重複" --input label 1 "${input}" --input label 1 "${input}" --name bad)
  invoke("${program}" "不正なオプション" --unknown)
endforeach()
invoke("${EVALUATOR}" "--inputが必要" --name bad)
invoke("${EVALUATOR}" "不正なオプション" --png)
invoke("${PLOTTER}" "一度だけ" --input label 1 "${input}" --name a --name b)
foreach(mode fail empty)
  set(ENV{PROJECT10_TEST_RENDER} "${mode}")
  invoke("${PLOTTER}" "gnuplot" --input label 1 "${input}" --name failed --gnuplot "${RENDERER}")
  if(EXISTS "${work}/runs/comparisons/failed")
    message(FATAL_ERROR "描画失敗後に出力が残っています")
  endif()
endforeach()
unset(ENV{PROJECT10_TEST_RENDER})
