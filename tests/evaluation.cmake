cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${TEST_ROOT}/evaluation-cli-${suffix}")
set(run "${work}/runs/run_0000")
file(MAKE_DIRECTORY "${run}")
file(READ "${SAMPLE_CONFIG}" config)
string(JSON config SET "${config}" num_players 2)
string(JSON config SET "${config}" matches_per_player 25)
file(WRITE "${run}/config.json" "${config}")
file(WRITE "${run}/players.csv" "player_id\n0\n1\n")
file(WRITE "${run}/ground_truth.csv" "player_a,player_b,p_a_wins\n0,1,0.5\n")
set(header "run_id,matches_per_player,player_a,player_b,predicted_p_a_wins\n")

function(evaluate input expected_error)
  file(WRITE "${work}/stdin.txt" "${input}")
  execute_process(COMMAND "${PROGRAM}" WORKING_DIRECTORY "${work}"
    INPUT_FILE "${work}/stdin.txt" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  if(expected_error STREQUAL "")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "MSE評価に失敗しました: ${output}${error}")
    endif()
  elseif(result STREQUAL "0" OR NOT error MATCHES "${expected_error}")
    message(FATAL_ERROR "期待したエラー「${expected_error}」と一致しません: ${result} ${output}${error}")
  endif()
endfunction()

# configs/が存在しなくても保存済み設定から動く。未完成の他手法のCSVは不要。
foreach(method IN ITEMS "Elo;elo" "Glicko;glicko" "Glicko2;glicko2" "TrueSkill;trueskill")
  list(GET method 0 algorithm)
  list(GET method 1 stem)
  file(WRITE "${run}/${stem}.csv" "${header}0,20,0,1,0.5\n0,10,0,1,0.75\n")
  evaluate("0\n${algorithm}\n" "")
  file(READ "${run}/${stem}_mse.csv" contents)
  string(REPLACE "\r\n" "\n" contents "${contents}")
  if(NOT contents STREQUAL "run_id,matches_per_player,mse\n0,10,0.0625\n0,20,0\n")
    message(FATAL_ERROR "MSE CSVの内容が正しくありません: ${contents}")
  endif()
endforeach()
file(SHA256 "${run}/elo_mse.csv" before)
evaluate("0\nElo\n" "MSE出力先がすでに存在します")
file(SHA256 "${run}/elo_mse.csv" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "既存の結果が変更されました")
endif()
# ここで消すのは、このテストが生成した出力だけ。
file(REMOVE "${run}/elo_mse.csv")
file(WRITE "${run}/elo.csv" "${header}0,10,0,1,0.5\n")
evaluate("0\nElo\n" "予測ペアが不足しています")
if(EXISTS "${run}/elo_mse.csv")
  message(FATAL_ERROR "評価に失敗したにもかかわらず結果が保存されました")
endif()
evaluate("0 abc\nElo\n" "run IDが不正です")
evaluate("0\nUnknown\n" "未対応の手法名です")
file(MAKE_DIRECTORY "${work}/runs/.run_0000.lock")
evaluate("0\nElo\n" "このrunはすでに使用中です")
file(REMOVE_RECURSE "${work}/runs/.run_0000.lock")
file(WRITE "${work}/protected.csv" "keep\n")
file(SHA256 "${work}/protected.csv" protected_hash)
foreach(link_type IN ITEMS hard symbolic)
  if(link_type STREQUAL "hard")
    file(CREATE_LINK "${work}/protected.csv" "${run}/elo_mse.csv" RESULT link_result)
  else()
    file(CREATE_LINK "${work}/protected.csv" "${run}/elo_mse.csv" SYMBOLIC RESULT link_result)
  endif()
  if(link_result STREQUAL "0")
    evaluate("0\nElo\n" "MSE出力先がすでに存在します")
    file(SHA256 "${work}/protected.csv" preserved_hash)
    if(NOT protected_hash STREQUAL preserved_hash)
      message(FATAL_ERROR "リンク先のファイルが変更されました")
    endif()
    file(REMOVE "${run}/elo_mse.csv")
  else()
    message(STATUS "${link_type} リンクの確認を実行できません: ${link_result}")
  endif()
endforeach()
string(JSON invalid_config SET "${config}" run_id 1)
file(WRITE "${run}/config.json" "${invalid_config}")
evaluate("0\nElo\n" "run IDが一致していません")
string(JSON invalid_config SET "${config}" evaluation_interval_matches_per_player 30)
file(WRITE "${run}/config.json" "${invalid_config}")
evaluate("0\nElo\n" "評価設定が不正")
string(JSON config SET "${config}" files mse Elo "\"players.csv\"")
file(WRITE "${run}/config.json" "${config}")
evaluate("0\nElo\n" "評価用のファイル名が規定と一致していません")
file(WRITE "${run}/config.json" "{")
evaluate("0\nElo\n" "設定JSONの構文が不正です")
file(WRITE "${run}/config.json" "{}")
evaluate("0\nElo\n" "設定JSONに必要な項目がありません")
string(JSON config SET "${config}" files predictions Elo 123)
file(WRITE "${run}/config.json" "${config}")
evaluate("0\nElo\n" "設定JSONの値の型が正しくありません")
if(EXISTS "${work}/runs/.run_0000.lock")
  message(FATAL_ERROR "runのロックが解除されていません")
endif()
