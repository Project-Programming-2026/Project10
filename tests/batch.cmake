cmake_minimum_required(VERSION 3.20)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(root "${TEST_ROOT}/batch-${MODE}-${suffix}")
set(work "${root}/normal")
file(READ "${SAMPLE_CONFIG}" config)
string(JSON config SET "${config}" num_players 8)
string(JSON config SET "${config}" matches_per_player 20)
string(JSON config SET "${config}" glicko
  "{\"initial_rating\":1500,\"initial_rd\":350,\"rd_growth\":0}")
function(prepare dir text)
  file(MAKE_DIRECTORY "${dir}/configs/run_0000")
  file(WRITE "${dir}/configs/run_0000/config.json" "${text}")
endfunction()
function(invoke program dir input expected)
  file(WRITE "${dir}/stdin.txt" "${input}")
  execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err
    TIMEOUT 40 ENCODING UTF-8)
  if(expected STREQUAL "")
    if(NOT status STREQUAL "0")
      message(FATAL_ERROR "一括実行失敗: ${status} ${out}${err}")
    endif()
  elseif(status STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "期待した拒否ではありません: ${expected}: ${status} ${out}${err}")
  endif()
endfunction()
function(no_lock dir)
  if(EXISTS "${dir}/runs/.run_0000.lock")
    message(FATAL_ERROR "自分のロックが残りました: ${dir}")
  endif()
endfunction()
prepare("${work}" "${config}")
if(MODE STREQUAL "render")
  if(NOT EXISTS "${GNUPLOT}")
    message("SKIP: gnuplot")
    return()
  endif()
  invoke("${PROGRAM}" "${work}" "0\n" "" --png --gnuplot "${GNUPLOT}")
  no_lock("${work}")
  return()
endif()
# 空白入りの配置先から起動し、Elo/Glicko2の子プロセスで入力分離を観測する。
set(tools "${root}/tools with spaces")
file(MAKE_DIRECTORY "${tools}")
foreach(name project10_run project10_glicko project10_trueskill)
  file(COPY "${BIN}/${name}${EXE}" DESTINATION "${tools}")
endforeach()
file(COPY_FILE "${BIN}/project10_predict${EXE}" "${tools}/real_project10_predict${EXE}")
file(COPY_FILE "${PROBE}" "${tools}/project10_predict${EXE}")
set(program "${tools}/project10_run${EXE}")
invoke("${program}" "${work}" "0\n" "" --png --gnuplot "${PROBE}")
set(run "${work}/runs/run_0000")
file(READ "${run}/project10_run.json" marker)
string(JSON producer GET "${marker}" producer)
string(JSON version GET "${marker}" schema_version)
string(JSON run_id GET "${marker}" run_id)
if(NOT producer STREQUAL "project10_run" OR NOT version EQUAL 1 OR NOT run_id EQUAL 0)
  message(FATAL_ERROR "run識別マーカーが不正です")
endif()
no_lock("${work}")
# 既存CLIを個別実行した場合と、4予測・4MSE・生成CSV・設定がバイト一致すること。
set(reference "${root}/reference")
prepare("${reference}" "${config}")
invoke("${BIN}/project10${EXE}" "${reference}" "0\n" "")
foreach(method Elo Glicko Glicko2 TrueSkill)
  if(method STREQUAL "Glicko")
    invoke("${BIN}/project10_glicko${EXE}" "${reference}" "0\n" "")
    set(stem glicko)
  elseif(method STREQUAL "TrueSkill")
    invoke("${BIN}/project10_trueskill${EXE}" "${reference}" "0\n" "")
    set(stem trueskill)
  else()
    invoke("${BIN}/project10_predict${EXE}" "${reference}" "" "" 0 "${method}")
    string(TOLOWER "${method}" stem)
  endif()
  invoke("${BIN}/project10_evaluate${EXE}" "${reference}" "0\n${method}\n" "")
  file(STRINGS "${run}/${stem}.csv" predictions)
  file(STRINGS "${run}/${stem}_mse.csv" mse)
  list(LENGTH predictions rows)
  list(LENGTH mse points)
  if(NOT rows EQUAL 57 OR NOT points EQUAL 3)
    message(FATAL_ERROR "予測ペア数または評価時点数の不一致: ${method}")
  endif()
endforeach()
file(GLOB files RELATIVE "${run}" "${run}/*.csv" "${run}/config.json")
foreach(name IN LISTS files)
  file(SHA256 "${run}/${name}" actual)
  file(SHA256 "${reference}/runs/run_0000/${name}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "個別実行と結果が一致しません: ${name}")
  endif()
endforeach()
file(GLOB_RECURSE files RELATIVE "${run}" "${run}/*")
foreach(name IN LISTS files)
  file(SHA256 "${run}/${name}" before_${name})
endforeach()
invoke("${program}" "${work}" "0\ny\n" "既存run")
foreach(name IN LISTS files)
  file(SHA256 "${run}/${name}" after)
  if(NOT after STREQUAL before_${name})
    message(FATAL_ERROR "既存runを変更しました: ${name}")
  endif()
endforeach()
foreach(case empty busy incompatible missing_glicko invalid_id renderer_failure worker_failure)
  set(dir "${root}/${case}")
  set(text "${config}")
  set(input "0\n")
  set(expected "既存run")
  set(selected "${program}")
  set(renderer "${PROBE}")
  if(case STREQUAL "empty")
    file(MAKE_DIRECTORY "${dir}/runs/run_0000")
  elseif(case STREQUAL "busy")
    file(MAKE_DIRECTORY "${dir}/runs/.run_0000.lock")
    set(expected "このrunはすでに使用中")
  elseif(case STREQUAL "incompatible")
    string(JSON text SET "${text}" evaluation_interval_matches_per_player 5)
    set(expected "Glicko2")
  elseif(case STREQUAL "missing_glicko")
    string(JSON text REMOVE "${text}" glicko)
    set(expected "設定にglicko")
  elseif(case STREQUAL "invalid_id")
    set(input "0x\n")
    set(expected "run IDが不正")
  elseif(case STREQUAL "renderer_failure")
    set(renderer "${root}/no such gnuplot")
    set(expected "グラフ生成")
  elseif(case STREQUAL "worker_failure")
    file(MAKE_DIRECTORY "${root}/missing workers")
    file(COPY "${PROGRAM}" DESTINATION "${root}/missing workers")
    set(selected "${root}/missing workers/project10_run${EXE}")
    set(expected "Elo予測")
  endif()
  prepare("${dir}" "${text}")
  invoke("${selected}" "${dir}" "${input}" "${expected}" --gnuplot "${renderer}")
  if(case STREQUAL "busy")
    if(NOT IS_DIRECTORY "${dir}/runs/.run_0000.lock")
      message(FATAL_ERROR "他者のロックを削除しました")
    endif()
  else()
    no_lock("${dir}")
  endif()
  if(case MATCHES "incompatible|missing_glicko|invalid_id|busy" AND EXISTS "${dir}/runs/run_0000")
    message(FATAL_ERROR "生成前の失敗なのにrunができました")
  endif()
  if(case MATCHES "renderer_failure|worker_failure")
    if(NOT EXISTS "${dir}/runs/run_0000/project10_run.json" OR EXISTS "${dir}/runs/run_0000/graphs")
      message(FATAL_ERROR "失敗後のマーカー・描画領域の状態が不正です")
    endif()
    invoke("${selected}" "${dir}" "0\n" "既存run")
  endif()
endforeach()
