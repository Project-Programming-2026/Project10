function(run_method dir method)
  if(method STREQUAL "Glicko")
    invoke_cmd("${GLICKO}" "${dir}" "__NO_STDIN__" "" 0 ${ARGN})
  elseif(method STREQUAL "TrueSkill")
    invoke_cmd("${TRUESKILL}" "${dir}" "__NO_STDIN__" "" 0 ${ARGN})
  else()
    invoke_cmd("${PREDICT}" "${dir}" "__NO_STDIN__" "" 0 "${method}" ${ARGN})
  endif()
endfunction()

