function(prepare dir id cfg)
  file(MAKE_DIRECTORY "${dir}/configs/run_000${id}" "${dir}/samples")
  file(WRITE "${dir}/configs/run_000${id}/config.json" "${cfg}")
  file(COPY "${BASELINE}" DESTINATION "${dir}/samples")
endfunction()

function(invoke_cmd program dir input expected)
  if(input STREQUAL "__NO_STDIN__")
    execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
      RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30 ENCODING UTF-8)
  else()
    file(WRITE "${dir}/stdin.txt" "${input}")
    execute_process(COMMAND "${program}" ${ARGN} WORKING_DIRECTORY "${dir}"
      INPUT_FILE "${dir}/stdin.txt" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30 ENCODING UTF-8)
  endif()
  if(expected STREQUAL "" AND NOT status STREQUAL "0")
    message(FATAL_ERROR "コマンド実行に失敗しました (${program} ${ARGN}): ${status}\n${out}${err}")
  elseif(NOT expected STREQUAL "" AND (status STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}"))
    message(FATAL_ERROR "想定したエラーが得られませんでした (${program} ${ARGN})\n期待: ${expected}\n終了コード: ${status}\n出力: ${out}${err}")
  endif()
endfunction()

function(assert_no_run_lock dir id)
  if(EXISTS "${dir}/runs/.run_000${id}.lock")
    message(FATAL_ERROR "runロックが残っています: ${dir}/runs/.run_000${id}.lock")
  endif()
endfunction()

function(assert_same_file actual expected label)
  file(SHA256 "${actual}" h_actual)
  file(SHA256 "${expected}" h_expected)
  if(NOT h_actual STREQUAL h_expected)
    message(FATAL_ERROR "ファイル内容が一致しません (${label}): ${actual} vs ${expected}")
  endif()
endfunction()

function(assert_diff_file a b label)
  file(SHA256 "${a}" h_a)
  file(SHA256 "${b}" h_b)
  if(h_a STREQUAL h_b)
    message(FATAL_ERROR "別入力にもかかわらず出力が同一です (${label}): ${a} vs ${b}")
  endif()
endfunction()

function(flip_last_column src dst zero_val one_val)
  file(STRINGS "${src}" lines)
  list(POP_FRONT lines header)
  set(out "${header}\n")
  foreach(line IN LISTS lines)
    if(NOT line MATCHES "^(.*),(${zero_val}|${one_val})$")
      message(FATAL_ERROR "CSV行の解析に失敗しました: ${line}")
    endif()
    if(CMAKE_MATCH_2 STREQUAL "${one_val}")
      string(APPEND out "${CMAKE_MATCH_1},${zero_val}\n")
    else()
      string(APPEND out "${CMAKE_MATCH_1},${one_val}\n")
    endif()
  endforeach()
  file(WRITE "${dst}" "${out}")
endfunction()

