  else()
    invoke_cmd("${PREDICT}" "${work}" "__NO_STDIN__" "すでに存在" 0 "${m}" --output "${stem_${m}}_alt.csv")
  endif()
  file(SHA256 "${target}" after_protect)
  if(NOT before_protect STREQUAL after_protect)
    message(FATAL_ERROR "既存出力先が上書きされました: ${target}")
  endif()
endforeach()

