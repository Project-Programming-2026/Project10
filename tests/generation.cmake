cmake_minimum_required(VERSION 3.20)

# 各テストはビルド領域に独立した作業先を作り、既存のrunsには触れない。
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(work "${TEST_ROOT}/${CASE}-${suffix}")
file(MAKE_DIRECTORY "${work}")
file(READ "${SAMPLE_CONFIG}" config)
string(JSON config SET "${config}" num_players 8)

function(prepare dir contents)
  file(MAKE_DIRECTORY "${dir}/configs/run_0000")
  file(WRITE "${dir}/configs/run_0000/config.json" "${contents}")
endfunction()

function(run_program dir input expected_error)
  file(WRITE "${dir}/stdin.txt" "${input}\n")
  execute_process(
    COMMAND "${PROGRAM}"
    WORKING_DIRECTORY "${dir}"
    INPUT_FILE "${dir}/stdin.txt"
    RESULT_VARIABLE result
    OUTPUT_VARIABLE output
    ERROR_VARIABLE error
    TIMEOUT 20
  )
  if(expected_error STREQUAL "")
    if(NOT result STREQUAL "0")
      message(FATAL_ERROR "Generation failed (${result}): ${output}${error}")
    endif()
  else()
    if(result STREQUAL "0" OR NOT error MATCHES "${expected_error}")
      message(FATAL_ERROR "Expected '${expected_error}', got (${result}): ${output}${error}")
    endif()
  endif()
  if(EXISTS "${dir}/runs/.run_0000.lock" AND NOT CASE STREQUAL "run_lock")
    message(FATAL_ERROR "Run lock was not released")
  endif()
endfunction()

function(no_output dir)
  if(EXISTS "${dir}/runs")
    message(FATAL_ERROR "Invalid input created an output directory: ${dir}")
  endif()
endfunction()

if(CASE STREQUAL "generation")
  prepare("${work}" "${config}")
  run_program("${work}" "0" "")
  set(output "${work}/runs/run_0000")
  file(GLOB files RELATIVE "${output}" "${output}/*")
  if(NOT files STREQUAL "config.json;ground_truth.csv;latent_parameters.csv;players.csv")
    message(FATAL_ERROR "Unexpected output files: ${files}")
  endif()
  file(STRINGS "${output}/players.csv" players)
  file(STRINGS "${output}/latent_parameters.csv" latent)
  file(STRINGS "${output}/ground_truth.csv" truth)
  list(LENGTH players player_rows)
  list(LENGTH latent latent_rows)
  list(LENGTH truth truth_rows)
  list(GET players 0 player_header)
  list(GET latent 0 latent_header)
  list(GET truth 0 truth_header)
  if(NOT player_rows EQUAL 9 OR NOT latent_rows EQUAL 9 OR
     NOT player_header STREQUAL "player_id" OR
     NOT latent_header STREQUAL "player_id,theta_0" OR
     NOT truth_rows EQUAL 29 OR NOT truth_header STREQUAL "player_a,player_b,p_a_wins")
    message(FATAL_ERROR "Incorrect CSV headers or row counts")
  endif()
  foreach(id RANGE 0 7)
    math(EXPR row "${id} + 1")
    list(GET players ${row} player)
    list(GET latent ${row} ability)
    if(NOT player STREQUAL "${id}" OR NOT ability MATCHES "^${id},[-+0-9.eE]+$")
      message(FATAL_ERROR "Invalid ID or ability at row ${row}: ${player} / ${ability}")
    endif()
  endforeach()
  # 期待する28ペアを順に照合し、重複・欠落・自己対戦・逆順を検出する。
  set(row 1)
  foreach(a RANGE 0 6)
    math(EXPR next "${a} + 1")
    foreach(b RANGE ${next} 7)
      list(GET truth ${row} entry)
      if(NOT entry MATCHES "^${a},${b},([0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?)$")
        message(FATAL_ERROR "Incorrect ground-truth pair or probability at row ${row}: ${entry}")
      endif()
      set(probability "${CMAKE_MATCH_1}")
      if(probability LESS 0 OR probability GREATER 1)
        message(FATAL_ERROR "Ground-truth probability out of range: ${entry}")
      endif()
      math(EXPR row "${row} + 1")
    endforeach()
  endforeach()
  file(SHA256 "${work}/configs/run_0000/config.json" input_hash)
  file(SHA256 "${output}/config.json" output_hash)
  if(NOT input_hash STREQUAL output_hash)
    message(FATAL_ERROR "Config snapshot differs from consumed input")
  endif()
elseif(CASE STREQUAL "reproducibility")
  foreach(copy first second)
    prepare("${work}/${copy}" "${config}")
    run_program("${work}/${copy}" "0" "")
  endforeach()
  foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
    file(SHA256 "${work}/first/runs/run_0000/${name}" first_hash)
    file(SHA256 "${work}/second/runs/run_0000/${name}" second_hash)
    if(NOT first_hash STREQUAL second_hash)
      message(FATAL_ERROR "Non-reproducible output: ${name}")
    endif()
  endforeach()
elseif(CASE STREQUAL "invalid_input")
  prepare("${work}" "${config}")
  foreach(input "-1" "abc" "0.5" "0 garbage" "2147483648" "")
    run_program("${work}" "${input}" "Invalid run ID")
    no_output("${work}")
  endforeach()
elseif(CASE STREQUAL "missing_config")
  run_program("${work}" "0" "Cannot open config file")
  no_output("${work}")
elseif(CASE STREQUAL "invalid_config")
  string(JSON wrong_id SET "${config}" run_id 1)
  string(JSON zero_players SET "${config}" num_players 0)
  string(JSON negative_players SET "${config}" num_players -1)
  string(JSON fractional_players SET "${config}" num_players 2.5)
  string(JSON oversized_players SET "${config}" num_players 4294967296)
  string(JSON bool_players SET "${config}" num_players true)
  string(JSON missing_seed REMOVE "${config}" seeds ability)
  string(JSON negative_seed SET "${config}" seeds ability -1)
  string(JSON fractional_seed SET "${config}" seeds ability 0.5)
  string(JSON bad_std SET "${config}" ability_distribution std 0)
  string(JSON bad_mean SET "${config}" ability_distribution mean "\"bad\"")
  string(JSON bad_type SET "${config}" ability_distribution type "\"uniform\"")
  string(JSON wrong_model SET "${config}" model "\"logistic\"")
  string(JSON empty_model SET "${config}" model "\"\"")
  string(JSON missing_model REMOVE "${config}" model)
  string(JSON non_string_model SET "${config}" model 1)
  string(JSON bad_period SET "${config}" rating_period_matches_per_player 0)
  string(JSON bad_performance SET "${config}" performance_std -1)
  string(JSON zero_performance SET "${config}" performance_std 0)
  string(JSON missing_performance REMOVE "${config}" performance_std)
  string(JSON missing_truth REMOVE "${config}" files ground_truth)
  string(JSON bad_truth_path SET "${config}" files ground_truth "\"../ground_truth.csv\"")
  string(JSON bad_path SET "${config}" files players "\"../players.csv\"")
  set(malformed "{broken json")
  foreach(name wrong_id zero_players negative_players fractional_players oversized_players
      bool_players missing_seed negative_seed fractional_seed bad_std bad_mean bad_type
      bad_period bad_performance zero_performance missing_performance missing_truth
      bad_truth_path bad_path malformed wrong_model empty_model missing_model non_string_model)
    prepare("${work}/${name}" "${${name}}")
    run_program("${work}/${name}" "0" "Error:")
    no_output("${work}/${name}")
  endforeach()
elseif(CASE STREQUAL "duplicate_keys")
  # JSON操作で重複が消えないよう、入力文字列に直接キーを追加する。
  string(SUBSTRING "${config}" 1 -1 members)
  set(index 0)
  foreach(extra IN ITEMS
      [=["num_players":0,]=]
      [=["num_players":8,]=]
      [=["num_\u0070layers":8,]=]
      [=["extra":{"value":1,"value":2},]=]
      [=["extra":[{"value":1,"value":2}],]=])
    math(EXPR index "${index} + 1")
    prepare("${work}/${index}" "{${extra}${members}")
    run_program("${work}/${index}" "0" "Duplicate config key:")
    no_output("${work}/${index}")
  endforeach()
  # 別オブジェクトの同名キーは重複ではない。未使用項目も保持して許容する。
  set(extra [=["extra":{"value":1,"child":{"value":2}},"items":[{"value":3},{"value":4}],]=])
  prepare("${work}/valid" "{${extra}${members}")
  run_program("${work}/valid" "0" "")
elseif(CASE STREQUAL "overwrite")
  prepare("${work}" "${config}")
  run_program("${work}" "0" "")
  foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
    file(SHA256 "${work}/runs/run_0000/${name}" before_${name})
  endforeach()
  file(WRITE "${work}/runs/run_0000/keep.txt" "existing result")
  # 設定を変えても、確認がなければ既存の4ファイルを更新しない。
  string(JSON updated_config SET "${config}" num_players 4)
  string(JSON updated_config SET "${updated_config}" performance_std 2.0)
  prepare("${work}" "${updated_config}")
  foreach(input "0" "0\n" "0\nn" "0\nN" "0\nyes")
    run_program("${work}" "${input}" "Overwrite cancelled")
    foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
      file(SHA256 "${work}/runs/run_0000/${name}" after)
      if(NOT after STREQUAL before_${name})
        message(FATAL_ERROR "Existing data changed without confirmation: ${name}")
      endif()
    endforeach()
  endforeach()
  # yとYを明示した場合のみ、現在の設定で再生成する。
  foreach(answer y Y)
    run_program("${work}" "0\n${answer}" "")
    foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
      file(SHA256 "${work}/runs/run_0000/${name}" after)
      if(after STREQUAL before_${name})
        message(FATAL_ERROR "Confirmed overwrite did not update: ${name}")
      endif()
    endforeach()
    file(STRINGS "${work}/runs/run_0000/players.csv" players)
    file(STRINGS "${work}/runs/run_0000/latent_parameters.csv" latent)
    file(STRINGS "${work}/runs/run_0000/ground_truth.csv" truth)
    list(LENGTH players player_rows)
    list(LENGTH latent latent_rows)
    list(LENGTH truth truth_rows)
    if(NOT player_rows EQUAL 5 OR NOT latent_rows EQUAL 5 OR NOT truth_rows EQUAL 7)
      message(FATAL_ERROR "Confirmed overwrite did not apply the new player count")
    endif()
    file(SHA256 "${work}/configs/run_0000/config.json" input_hash)
    file(SHA256 "${work}/runs/run_0000/config.json" snapshot_hash)
    if(NOT input_hash STREQUAL snapshot_hash)
      message(FATAL_ERROR "Confirmed overwrite did not save the current config")
    endif()
  endforeach()
  file(READ "${work}/runs/run_0000/keep.txt" sentinel)
  if(NOT sentinel STREQUAL "existing result")
    message(FATAL_ERROR "Existing extra data changed")
  endif()
  # 空のディレクトリでも確認を求め、拒否時にはファイルを作らない。
  string(JSON empty_config SET "${config}" run_id 1)
  file(MAKE_DIRECTORY "${work}/configs/run_0001" "${work}/runs/run_0001")
  file(WRITE "${work}/configs/run_0001/config.json" "${empty_config}")
  run_program("${work}" "1" "Overwrite cancelled")
  file(GLOB empty_files "${work}/runs/run_0001/*")
  if(empty_files)
    message(FATAL_ERROR "Cancelled generation wrote into an existing empty directory")
  endif()
  run_program("${work}" "1\ny" "")
  file(GLOB created_files RELATIVE "${work}/runs/run_0001" "${work}/runs/run_0001/*")
  if(NOT created_files STREQUAL "config.json;ground_truth.csv;latent_parameters.csv;players.csv")
    message(FATAL_ERROR "Confirmed generation into an empty directory failed")
  endif()
elseif(CASE STREQUAL "output_paths" OR CASE STREQUAL "symlink_outputs" OR
    CASE STREQUAL "hardlink_outputs")
  # 最後に保存する設定も含め、1つでも不正なら先行するCSVも更新しない。
  foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
    set(dir "${work}/${name}")
    prepare("${dir}" "${config}")
    run_program("${dir}" "0" "")
    foreach(file players.csv latent_parameters.csv ground_truth.csv config.json)
      file(SHA256 "${dir}/runs/run_0000/${file}" before_${file})
    endforeach()
    set(path "${dir}/runs/run_0000/${name}")
    file(REMOVE "${path}")
    set(expected_error "Output path must be a regular file:")
    if(CASE STREQUAL "symlink_outputs" OR CASE STREQUAL "hardlink_outputs")
      set(target "${dir}/shared/${name}")
      file(MAKE_DIRECTORY "${dir}/shared")
      file(WRITE "${target}" "shared data must survive")
      file(SHA256 "${target}" target_hash)
      if(CASE STREQUAL "symlink_outputs")
        file(CREATE_LINK "${target}" "${path}" SYMBOLIC RESULT link_result)
      else()
        # コピーへフォールバックせず、本物のハードリンクで検証する。
        file(CREATE_LINK "${target}" "${path}" RESULT link_result)
        set(expected_error "Output path must not have multiple hard links:")
      endif()
      if(NOT link_result STREQUAL "0")
        if(CASE STREQUAL "symlink_outputs" AND WIN32 AND
            link_result MATCHES "privilege|Privilege|1314|要求された特権")
          message("Symbolic link creation unavailable: ${link_result}")
          return()
        endif()
        message(FATAL_ERROR "Cannot create test link: ${link_result}")
      endif()
    else()
      file(MAKE_DIRECTORY "${path}")
    endif()
    run_program("${dir}" "0\ny" "${expected_error}")
    foreach(file players.csv latent_parameters.csv ground_truth.csv config.json)
      if(NOT file STREQUAL name)
        file(SHA256 "${dir}/runs/run_0000/${file}" after)
        if(NOT after STREQUAL before_${file})
          message(FATAL_ERROR "Preflight failure changed another file: ${file}")
        endif()
      endif()
    endforeach()
    if(CASE STREQUAL "hardlink_outputs")
      file(SHA256 "${target}" after_target)
      file(SHA256 "${path}" after_path)
      if(NOT after_target STREQUAL target_hash OR NOT after_path STREQUAL target_hash)
        message(FATAL_ERROR "Shared hard-link data was changed")
      endif()
    elseif(CASE STREQUAL "symlink_outputs")
      file(SHA256 "${target}" after)
      if(NOT IS_SYMLINK "${path}" OR NOT after STREQUAL target_hash)
        message(FATAL_ERROR "Shared symbolic-link target was changed")
      endif()
      # 存在しないリンク先も作成せず拒否する。
      file(REMOVE "${target}")
      run_program("${dir}" "0\ny" "Output path must be a regular file:")
      if(EXISTS "${target}")
        message(FATAL_ERROR "Dangling symbolic-link target was created")
      endif()
    endif()
  endforeach()
elseif(CASE STREQUAL "run_lock")
  prepare("${work}" "${config}")
  set(lock "${work}/runs/.run_0000.lock")
  # 生成中の別プロセスと同じロックを用意し、新規作成・上書きを両方拒否する。
  file(MAKE_DIRECTORY "${lock}")
  run_program("${work}" "0\ny" "Run is already in use:")
  if(EXISTS "${work}/runs/run_0000" OR NOT IS_DIRECTORY "${lock}")
    message(FATAL_ERROR "Busy run was created or another owner's lock was removed")
  endif()
  file(REMOVE_RECURSE "${lock}")
  run_program("${work}" "0" "")
  if(EXISTS "${lock}")
    message(FATAL_ERROR "Successful generation did not release its lock")
  endif()
  foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
    file(SHA256 "${work}/runs/run_0000/${name}" before_${name})
  endforeach()
  file(MAKE_DIRECTORY "${lock}")
  run_program("${work}" "0\ny" "Run is already in use:")
  foreach(name players.csv latent_parameters.csv ground_truth.csv config.json)
    file(SHA256 "${work}/runs/run_0000/${name}" after)
    if(NOT after STREQUAL before_${name})
      message(FATAL_ERROR "Busy run changed: ${name}")
    endif()
  endforeach()
  if(NOT IS_DIRECTORY "${lock}")
    message(FATAL_ERROR "Another owner's lock was removed")
  endif()
else()
  message(FATAL_ERROR "Unknown test case: ${CASE}")
endif()
